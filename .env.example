# Base de datos PostgreSQL (Docker Compose)
DB_HOST=
DB_PORT=5432
DB_NAME=actas
DB_USER=actas
DB_PASSWORD=replace-with-a-long-random-password

# Django
DJANGO_SECRET_KEY=replace-with-a-long-random-secret-key
APP_IMAGE=actas-entrega:latest
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_SECURE_SSL_REDIRECT=False
DJANGO_SECURE_HSTS_SECONDS=0
DJANGO_SECURE_PROXY_SSL_HEADER=False
PORT=8000

# Alternativa para despliegues configurados mediante URL. Dejar vacío con DB_*.
DATABASE_URL=

# Integración GLPI
GLPI_BASE_URL=https://glpi.example.com/apirest.php
GLPI_APP_TOKEN=
GLPI_USER_TOKEN=
GLPI_SIMULATION_MODE=True
GLPI_UPLOAD_ENABLED=False

# Correo
DEFAULT_FROM_EMAIL=no-reply@synerjoy.com
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
